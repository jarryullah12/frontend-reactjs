import React, { useState, useEffect, useRef } from 'react';
import { useAppDispatch, useAppSelector } from '../redux/hooks';
import { likePost, addComment, deletePost, sharePost } from '../redux/slices/postsSlice';
import { v4 as uuidv4 } from 'uuid';
import DefaultProfileImage from './DefaultProfileImage';
import { DEFAULT_GRAY_PROFILE_IMAGE } from '../assets/images/defaultImages';
import { useSession } from '../contexts/SessionContext';

interface Comment {
  id: number | string;
  user: {
    name: string;
    image: string;
  };
  text: string;
  time: string;
  replies?: number;
  likes?: number;
}

interface PostData {
  id: number | string;
  user: {
    name: string;
    image: string;
    email?: string;
    title?: string;
    company?: string;
    time?: string;
  };
  content: string;
  image?: string;
  images?: string[];
  videos?: string[];
  likes: number;
  comments?: number;
  commentsList?: any[];
  shares: number;
  replies?: Comment[];
  isLiked?: boolean;
  userId?: string;
  originalPostId?: string;
  isShared?: boolean;
  sharedPost?: PostData;
}

interface PostProps {
  post: PostData;
}

const Post = ({ post }: PostProps) => {
  const dispatch = useAppDispatch();
  const currentUser = useAppSelector(state => state.user.currentUser);
  const { session } = useSession();
  const [isLiked, setIsLiked] = useState(post.isLiked || false);
  const [showComments, setShowComments] = useState(false);
  const [commentText, setCommentText] = useState('');
  const [showMenu, setShowMenu] = useState(false);
  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);
  const [showShareDialog, setShowShareDialog] = useState(false);
  const [shareComment, setShareComment] = useState('');
  const menuRef = useRef<HTMLDivElement>(null);
  const shareDialogRef = useRef<HTMLDivElement>(null);
  
  // Close menu when clicking outside
  useEffect(() => {
    function handleClickOutside(event: MouseEvent) {
      if (menuRef.current && !menuRef.current.contains(event.target as Node)) {
        setShowMenu(false);
      }
      
      if (shareDialogRef.current && !shareDialogRef.current.contains(event.target as Node) && showShareDialog) {
        setShowShareDialog(false);
      }
    }
    
    document.addEventListener("mousedown", handleClickOutside);
    return () => {
      document.removeEventListener("mousedown", handleClickOutside);
    };
  }, [showShareDialog]);
  
  // Show comments automatically if there are any
  useEffect(() => {
    console.log("Post component - Post:", post);
    console.log("Post component - Comments list:", post.commentsList);
    console.log("Post component - Replies:", post.replies);
    
    if ((post.replies && post.replies.length > 0) || 
        (post.commentsList && post.commentsList.length > 0)) {
      setShowComments(true);
    }
  }, [post.replies, post.commentsList]);
  
  const handleLike = () => {
    setIsLiked(!isLiked);
    
    // If the post has a string ID, dispatch to Redux
    if (typeof post.id === 'string') {
      dispatch(likePost(post.id));
    }
  };
  
  const toggleComments = () => {
    setShowComments(!showComments);
  };

  const handleAddComment = (e: React.FormEvent) => {
    e.preventDefault();
    
    if (!commentText.trim()) return;
    
    const newComment = {
      id: uuidv4(),
      postId: post.id.toString(),
      userId: currentUser?.id || 'default-user',
      userName: currentUser?.name || 'Current User',
      userAvatar: currentUser?.avatar || '',
      text: commentText,
      timestamp: new Date().toISOString(),
      likes: 0
    };
    
    console.log("Adding new comment:", newComment);
    dispatch(addComment(newComment));
    setCommentText('');
    
    // Show comments after adding a new one
    if (!showComments) {
      setShowComments(true);
    }
  };
  
  const handleDeletePost = () => {
    if (typeof post.id === 'string') {
      dispatch(deletePost(post.id));
      setShowDeleteConfirm(false);
      setShowMenu(false);
    }
  };
  
  const handleSharePost = () => {
    if (typeof post.id === 'string' && currentUser) {
      dispatch(sharePost({
        postId: post.id,
        userId: currentUser.id || 'default-user',
        userName: currentUser.name || 'Current User',
        userAvatar: currentUser.avatar || '',
        shareComment: shareComment.trim() || undefined
      }));
      
      setShareComment('');
      setShowShareDialog(false);
    }
  };
  
  // Check if current user is the post owner
  const isPostOwner = currentUser?.id === post.userId;

  // Calculate total comments (replies + commentsList)
  const totalComments = 
    (post.replies ? post.replies.length : 0) + 
    (post.commentsList ? post.commentsList.length : 0);

  return (
    <div className="bg-white dark:bg-dark-secondary rounded-xl shadow-sm overflow-hidden dark:border dark:border-dark-border transition-colors mb-4">
      {/* Post Header */}
      <div className="p-4">
        <div className="flex items-center justify-between">
          <div className="flex items-center">
            {post.user.image ? (
              <img
                src={post.user.image}
                alt={post.user.name || 'User'}
                className="w-10 h-10 rounded-full object-cover mr-3"
              />
            ) : (
              <div className="mr-3">
                <DefaultProfileImage size={40} />
              </div>
            )}
            <div>
              {post.user.email || (session.email && currentUser?.id === post.userId) ? (
                <div className="font-medium dark:text-white">
                  {post.user.email || (currentUser?.id === post.userId ? session.email : '')}
                </div>
              ) : (
                <div className="font-medium dark:text-white">{post.user.name}</div>
              )}
              {post.user.title && (
                <div className="text-xs text-gray-500 dark:text-gray-400">
                  {post.user.title} 
                  {post.user.time && <span> · {post.user.time}</span>}
                </div>
              )}
              {post.isShared && (
                <div className="text-xs text-blue-500 mt-1 flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" className="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                  </svg>
                  Shared Post
                </div>
              )}
            </div>
          </div>
          <div className="relative" ref={menuRef}>
            <button 
              className="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300"
              onClick={() => setShowMenu(!showMenu)}
            >
              <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
              </svg>
          </button>
            
            {/* Dropdown Menu */}
            {showMenu && (
              <div className="absolute right-0 mt-1 w-48 bg-white dark:bg-dark-secondary rounded-md shadow-lg z-10 border border-gray-200 dark:border-dark-border">
                <ul className="py-1">
                  {isPostOwner && (
                    <li>
                      <button 
                        className="w-full text-left px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-gray-100 dark:hover:bg-dark-bg"
                        onClick={() => {
                          setShowDeleteConfirm(true);
                          setShowMenu(false);
                        }}
                      >
                        Delete post
                      </button>
                    </li>
                  )}
                  <li>
                    <button 
                      className="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-bg"
                      onClick={() => {
                        setShowShareDialog(true);
                        setShowMenu(false);
                      }}
                    >
                      Share post
                    </button>
                  </li>
                  <li>
                    <button className="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-bg">
                      Save post
                    </button>
                  </li>
                  <li>
                    <button className="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-bg">
                      Report post
                    </button>
                  </li>
                </ul>
              </div>
            )}
          </div>
        </div>
      </div>
      
      {/* Delete Confirmation Dialog */}
      {showDeleteConfirm && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div className="bg-white dark:bg-dark-secondary rounded-lg p-6 max-w-sm w-full mx-4">
            <h3 className="text-lg font-medium text-gray-900 dark:text-white mb-4">Delete Post</h3>
            <p className="text-gray-700 dark:text-gray-300 mb-6">Are you sure you want to delete this post? This action cannot be undone.</p>
            <div className="flex justify-end space-x-3">
              <button 
                className="px-4 py-2 rounded-md text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-dark-bg hover:bg-gray-200 dark:hover:bg-opacity-80"
                onClick={() => setShowDeleteConfirm(false)}
              >
                Cancel
              </button>
              <button 
                className="px-4 py-2 rounded-md text-white bg-red-600 hover:bg-red-700"
                onClick={handleDeletePost}
              >
                Delete
              </button>
            </div>
      </div>
        </div>
      )}
      
      {/* Share Dialog */}
      {showShareDialog && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
          <div 
            ref={shareDialogRef}
            className="bg-white dark:bg-dark-secondary rounded-lg p-6 max-w-md w-full mx-4"
          >
            <div className="flex justify-between items-center mb-4">
              <h3 className="text-lg font-medium text-gray-900 dark:text-white">Share Post</h3>
              <button 
                className="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
                onClick={() => setShowShareDialog(false)}
              >
                <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fillRule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clipRule="evenodd" />
                </svg>
              </button>
            </div>
            
            <div className="mb-4">
              <div className="flex items-center mb-3">
                {currentUser && currentUser.avatar ? (
                  <img 
                    src={currentUser.avatar}
                    alt="Your profile"
                    className="w-10 h-10 rounded-full object-cover mr-3"
                  />
                ) : (
                  <div className="mr-3">
                    <DefaultProfileImage size={40} />
                  </div>
                )}
                <div className="font-medium dark:text-white">{currentUser?.name || "Current User"}</div>
              </div>
              
              <textarea 
                placeholder="Add a comment about this post..."
                className="w-full border border-gray-200 dark:border-dark-border rounded-lg p-3 h-24 focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none text-sm bg-white dark:bg-dark-bg dark:text-white dark:placeholder-gray-400"
                value={shareComment}
                onChange={(e) => setShareComment(e.target.value)}
              ></textarea>
            </div>
            
            <div className="bg-gray-50 dark:bg-dark-bg p-3 rounded-lg mb-4">
              <div className="flex items-center">
                {post.user.image ? (
                  <img 
                    src={post.user.image}
                    alt={post.user.name}
                    className="w-8 h-8 rounded-full object-cover mr-2"
                  />
                ) : (
                  <div className="mr-2">
                    <DefaultProfileImage size={32} />
                  </div>
                )}
                <div>
                  <div className="font-medium text-sm dark:text-white">{post.user.name}</div>
                  {post.user.title && (
                    <div className="text-xs text-gray-500 dark:text-gray-400">{post.user.title}</div>
                  )}
                </div>
              </div>
              <p className="text-sm text-gray-700 dark:text-gray-300 mt-2 line-clamp-2">{post.content}</p>
              
              {post.images && post.images.length > 0 && (
                <div className="mt-2">
                  <img 
                    src={post.images?.[0]} 
                    alt="Post preview" 
                    className="h-16 w-auto object-cover rounded"
                  />
                </div>
              )}
            </div>
            
            <div className="flex justify-end space-x-3">
              <button 
                className="px-4 py-2 rounded-md text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-dark-bg hover:bg-gray-200 dark:hover:bg-opacity-80"
                onClick={() => setShowShareDialog(false)}
              >
                Cancel
              </button>
              <button 
                className="px-4 py-2 rounded-md text-white bg-blue-500 hover:bg-blue-600"
                onClick={handleSharePost}
              >
                Share
              </button>
            </div>
          </div>
        )}
      
      {/* Post Content */}
      <div className="px-4 pb-3">
        <p className="text-gray-800 dark:text-gray-200 mb-2">{post.content}</p>
        
        {/* Post images */}
        {post.images && post.images.length > 0 && (
          <div className={`mt-3 grid gap-2 ${post.images.length === 1 ? 'grid-cols-1' : post.images.length === 2 ? 'grid-cols-2' : 'grid-cols-3'}`}>
            {post.images && post.images.map((image, index) => (
              <div 
                key={index} 
                className={`${
                  post.images && post.images.length === 1 
                    ? 'col-span-1' 
                    : post.images && post.images.length > 2 && index === 0 
                      ? 'col-span-3' 
                      : 'col-span-1'
                } overflow-hidden rounded-lg`}
              >
                <img 
                  src={image} 
                  alt={`Post image ${index + 1}`} 
                  className="w-full h-full object-cover"
                  style={{ maxHeight: post.images && post.images.length === 1 ? '500px' : '200px' }}
                />
              </div>
            ))}
          </div>
        )}
        
        {/* Post videos */}
        {post.videos && post.videos.length > 0 && (
          <div className={`mt-3 grid gap-2 ${post.videos.length === 1 ? 'grid-cols-1' : 'grid-cols-2'}`}>
            {post.videos && post.videos.map((video, index) => (
              <div key={index} className="overflow-hidden rounded-lg">
                <video 
                  src={video} 
                  controls 
                  className="w-full"
                  style={{ maxHeight: '500px' }}
                />
              </div>
            ))}
        </div>
      )}
      
      {/* Post Stats */}
        <div className="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400 py-2 border-t border-b border-gray-100 dark:border-dark-border">
          <div>
            {post.likes > 0 && (
          <span className="flex items-center">
                <span className="bg-blue-500 text-white rounded-full p-1 mr-1">
                  <svg xmlns="http://www.w3.org/2000/svg" className="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
            </svg>
                </span>
            {post.likes}
          </span>
            )}
          </div>
          <div>
            {totalComments > 0 && <span>{totalComments} comments</span>}
            {post.shares > 0 && <span> · {post.shares} shares</span>}
          </div>
      </div>
      
      {/* Post Actions */}
        <div className="flex justify-between pt-3 text-gray-600 dark:text-gray-300">
        <button 
          className={`flex items-center ${isLiked ? 'text-blue-500' : ''}`}
          onClick={handleLike}
        >
            <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 mr-1" fill={isLiked ? "currentColor" : "none"} viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={isLiked ? 0 : 2} d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
          </svg>
          Like
        </button>
        
        <button 
          className="flex items-center"
          onClick={toggleComments}
        >
          <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          Comment
        </button>
        
          <button 
            className="flex items-center"
            onClick={() => setShowShareDialog(true)}
          >
          <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          Share
        </button>
        </div>
      </div>
      
      {/* Comments */}
      {showComments && (
        <div className="bg-gray-50 dark:bg-dark-bg px-4 py-3">
          {/* Existing comments from replies array */}
          {post.replies && post.replies.length > 0 && post.replies.map((comment, index) => (
            <div key={index} className="flex mb-3">
              {comment.user.image ? (
                <img 
                  src={comment.user.image}
                  alt={comment.user.name}
                  className="w-8 h-8 rounded-full object-cover mr-2"
                />
              ) : (
                <div className="mr-2">
                  <DefaultProfileImage size={32} />
                </div>
              )}
              <div>
                <div className="bg-white dark:bg-dark-secondary rounded-lg px-3 py-2 mb-1">
                  <div className="font-medium text-sm dark:text-white">{comment.user.name}</div>
                  <p className="text-sm text-gray-700 dark:text-gray-300">{comment.text}</p>
                </div>
                <div className="flex space-x-2 text-xs text-gray-500 dark:text-gray-400">
                  <button>Like</button>
                  <button>Reply</button>
                  <span>{comment.time}</span>
                </div>
              </div>
            </div>
          ))}
          
          {/* Comments from Redux store */}
          {post.commentsList && post.commentsList.length > 0 && post.commentsList.map((comment, index) => (
            <div key={index} className="flex mb-3">
              {comment.userAvatar ? (
                <img 
                  src={comment.userAvatar}
                  alt={comment.userName}
                  className="w-8 h-8 rounded-full object-cover mr-2"
                />
              ) : (
                <div className="mr-2">
                  <DefaultProfileImage size={32} />
                </div>
              )}
              <div>
                <div className="bg-white dark:bg-dark-secondary rounded-lg px-3 py-2 mb-1">
                  <div className="font-medium text-sm dark:text-white">{comment.userName}</div>
                  <p className="text-sm text-gray-700 dark:text-gray-300">{comment.text}</p>
                </div>
                <div className="flex space-x-2 text-xs text-gray-500 dark:text-gray-400">
                  <button>Like</button>
                  <button>Reply</button>
                  <span>{new Date(comment.timestamp).toLocaleTimeString()}</span>
                </div>
              </div>
            </div>
          ))}
          
          {/* Comment input */}
          <form onSubmit={handleAddComment} className="flex mt-2">
            <img 
              src={DEFAULT_GRAY_PROFILE_IMAGE}
              alt="Your profile"
              className="w-8 h-8 rounded-full object-cover mr-2"
            />
            <div className="flex-1 relative">
              <input 
                type="text"
                placeholder={`Write a comment${session.email ? ` as ${session.email}` : ''}...`}
                className="w-full bg-white dark:bg-dark-secondary border border-gray-200 dark:border-dark-border rounded-full py-1 px-3 text-sm focus:outline-none focus:border-blue-300 dark:text-white dark:placeholder-gray-400"
                value={commentText}
                onChange={(e) => setCommentText(e.target.value)}
              />
              <button 
                type="submit"
                className="absolute right-3 top-1/2 transform -translate-y-1/2 text-blue-500"
              >
                <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/>
                </svg>
              </button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
};

export default Post;